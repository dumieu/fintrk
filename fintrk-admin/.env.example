# Neon (required) — same database as FinTRK user app
DATABASE_URL=

# Admin allow-list (comma-separated emails). Empty = fail-closed in production; any signed-in user in dev.
ADMIN_EMAILS=

# Clerk — admin app instance
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk — FinTRK user app (plan metadata + hard delete). Falls back to CLERK_SECRET_KEY if unset.
USER_APP_CLERK_SECRET_KEY=

# Field-level encryption (must match FinTRK user app, min 32 chars)
FINTRK_ENCRYPTION_KEY=

# Cron test triggers (Security / Crons)
USER_APP_URL=http://localhost:3004
CRON_SECRET=

# Stripe (presence check + user-app billing context)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google AI (statement / insights)
GOOGLE_API_KEY=

# Optional: live Vercel cron schedules on Crons page
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_USER_APP_ID=

# Local HTTPS script
NEXT_PUBLIC_APP_URL=https://local.admin.fintrk.io:3005
